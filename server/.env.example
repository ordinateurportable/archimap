# Образец настроек. Скопируйте в server/.env и поправьте под себя —
# .env в git не попадает (см. .gitignore).

# Пароль для входа в режим админа. Локально можно не задавать: тогда
# действует «dev». В продакшене сервер без этой переменной не стартует.
ADMIN_PASSWORD=смените-меня

# Сколько часов живёт сессия админа после входа.
TOKEN_TTL_HOURS=12

# Порт сервера правок. Vite проксирует /api сюда (см. web/vite.config.js).
PORT=5174

# Сколько всего уточнений готовы хранить, прежде чем отказывать.
MAX_SUGGESTIONS=5000

# Заполняйте, только если перед сервером стоит nginx или другой прокси:
# тогда настоящий адрес приходит в X-Forwarded-For. Значение — как в
# app.set('trust proxy', ...) у Express, обычно 1 (один прокси).
# Без прокси оставьте пустым, иначе ограничения обходятся подделкой заголовка.
# TRUST_PROXY=1

# В продакшене обязательно: NODE_ENV=production

# Сколько постов посетителей может одновременно ждать модерации.
MAX_PENDING_POSTS=300
