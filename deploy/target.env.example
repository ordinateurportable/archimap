# Куда выкладывать. Скопируйте в deploy/target.env (в git не идёт) и
# впишите свой сервер — его читают upload.sh, check-map.sh, check-access.sh.
ARCHIMAP_HOST=root@<IP сервера>
ARCHIMAP_KEY="$HOME/.ssh/archimap_deploy"
ARCHIMAP_SITE=https://archimap.<IP сервера>.sslip.io
# адрес VPN, который проверяет check-access.sh (можно оставить пустым)
ARCHIMAP_VPN_IP=
